<template>
  <div class="page home-page home-page-{{ screenSize }} home-page-{{ screenViewport }}">
    <div class="brand-row">
      <text class="brand">腕上节律</text>
      <text class="eyebrow">RHYTHM / NOW</text>
    </div>

    <div class="vital-orbit vital-orbit-{{ screenViewport }} {{ suggest ? 'orbit-alert' : 'orbit-steady' }}">
      <div class="orbit-pulse orbit-pulse-{{ screenViewport }} {{ vitalPulseClass }}"></div>
      <div class="orbit-ring orbit-ring-{{ screenViewport }}">
        <text class="status-dot {{ suggest ? 'status-dot-alert' : '' }}">●</text>
        <text class="status-title">{{ statusTitle }}</text>
        <text class="status-subtitle">{{ statusSubtitle }}</text>
        <div class="metrics metrics-{{ screenSize }} metrics-{{ screenViewport }}">
          <div class="metric metric-{{ screenViewport }}">
            <text class="metric-value">{{ heartRateText }}</text>
            <text class="metric-label">心率 bpm</text>
          </div>
          <div class="metric-divider"></div>
          <div class="metric metric-{{ screenViewport }}">
            <text class="metric-value">{{ stressText }}</text>
            <text class="metric-label">压力分</text>
          </div>
        </div>
      </div>
    </div>

    <text if="{{ healthMessage }}" class="health-message health-message-{{ screenViewport }}">{{ healthMessage }}</text>
    <div class="mode-buttons mode-buttons-{{ screenSize }} mode-buttons-{{ screenViewport }}">
      <div class="mode-button mode-button-{{ screenViewport }} steady-mode" onclick="startTraining">
        <text class="mode-kicker">01 / 放松</text>
        <text class="mode-title">稳态 60</text>
      </div>
      <div class="mode-button mode-button-{{ screenViewport }} boxing-mode" onclick="startBoxing">
        <text class="mode-kicker boxing-kicker">02 / 活力</text>
        <text class="mode-title">节奏拳</text>
      </div>
    </div>
    <text class="disclaimer disclaimer-{{ screenViewport }}">训练体验仅供参考，不作为医疗建议</text>
  </div>
</template>

<script>
export default {
  props: {
    screenSize: { type: String, default: 'regular' },
    screenViewport: { type: String, default: 'normal' },
    suggest: { type: Boolean, default: false },
    vitalPulseClass: { type: String, default: 'pulse-a' },
    statusTitle: { type: String, default: '' },
    statusSubtitle: { type: String, default: '' },
    heartRateText: { type: String, default: '--' },
    stressText: { type: String, default: '--' },
    healthMessage: { type: String, default: '' },
  },
  startTraining() { this.$emit('startTraining'); },
  startBoxing() { this.$emit('startBoxing'); },
};
</script>

